# `.env.example`

# ============================================================
# NGABINTON — Environment Variables Template
# ============================================================
# Cara pakai:
#   1. Copy file ini: cp .env.example .env.local
#   2. Isi semua nilai di .env.local
#   3. JANGAN commit .env.local ke git (sudah di-gitignore)
#
# JANGAN ubah file ini untuk development.
# File ini hanya template. Nilai asli ada di .env.local.
# ============================================================


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# Postgres connection string dari Supabase.
#
# PENTING: Pakai POOLER (port 6543), BUKAN direct (port 5432).
# Vercel serverless tidak bisa handle direct connection dengan baik.
#
# Cara ambil:
#   Supabase → Settings → Database → Connection string → Connection pooling
#
# Format:
#   postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"


# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------
# JWT signing secret. Minimal 32 byte random.
#
# Generate dengan:
#   macOS/Linux:  openssl rand -base64 32
#   Node:         node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   Windows PS:   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#
# JANGAN pakai nilai contoh di bawah. Generate yang baru.
# Kalau secret ini bocor, semua admin harus login ulang setelah rotate.
#
AUTH_SECRET="generate-dengan-openssl-rand-base64-32"


# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
# URL publik aplikasi. Dipakai untuk:
#   - Generate QR code URL
#   - Metadata OG image
#   - Redirect setelah login
#
# Dev:         http://localhost:3000
# Production:  https://ngabinton.vercel.app (atau custom domain)
#
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------
# Cara ambil:
#   Supabase → Settings → API
#
# SUPABASE_URL:                 Project URL
# SUPABASE_ANON_KEY:            anon/public key (aman dipakai di client)
# SUPABASE_SERVICE_ROLE_KEY:    service_role key (RAHASIA, server-only!)
#
# ⚠️  SERVICE_ROLE_KEY JANGAN pernah di-expose ke client.
# ⚠️  Jangan pakai prefix NEXT_PUBLIC_ untuk key ini.
#
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# ------------------------------------------------------------
# UPSTASH REDIS
# ------------------------------------------------------------
# Redis untuk rate limiting (login, submit presensi, dll).
#
# Cara ambil:
#   Upstash → Database → REST API → Node
#
# Region: ap-southeast-1 (Singapore)
#
UPSTASH_REDIS_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_TOKEN="AXxxxx..."


# ------------------------------------------------------------
# SEED (Development only)
# ------------------------------------------------------------
# Dipakai hanya oleh `scripts/seed.ts` untuk buat admin pertama.
#
# ⚠️  JANGAN set di Vercel / production. Hapus setelah seed pertama.
# ⚠️  Password minimal 12 karakter.
#
# Setelah seed, login dan langsung ganti password via /admin/settings.
#
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ganti-dengan-password-kuat-min-12-char"


# ============================================================
# RINGKASAN
# ============================================================
#
# Wajib diisi (semua environment):
#   [x] DATABASE_URL
#   [x] AUTH_SECRET
#   [x] NEXT_PUBLIC_APP_URL
#   [x] SUPABASE_URL
#   [x] SUPABASE_ANON_KEY
#   [x] SUPABASE_SERVICE_ROLE_KEY
#   [x] UPSTASH_REDIS_URL
#   [x] UPSTASH_REDIS_TOKEN
#
# Hanya dev (JANGAN di production):
#   [x] SEED_ADMIN_USERNAME
#   [x] SEED_ADMIN_PASSWORD
#
# ============================================================
# CHECKLIST SEBELUM DEPLOY
# ============================================================
#
#   [ ] Semua env var wajib sudah di-set di Vercel
#   [ ] NEXT_PUBLIC_APP_URL sudah domain production (bukan localhost)
#   [ ] SEED_ADMIN_* TIDAK di-set di Vercel
#   [ ] AUTH_SECRET sudah di-generate baru (bukan copy dari dev)
#   [ ] DATABASE_URL pakai pooler (port 6543, bukan 5432)
#   [ ] Sudah test login di production
#   [ ] Sudah ganti password admin default setelah seed production
#
# ============================================================

# ------------------------------------------------------------
# GOOGLE DRIVE (Arsip Dokumentasi)
# ------------------------------------------------------------
# Upload foto dokumentasi memakai OAuth milik satu akun Google
# (bukan per-user). Isi sekali lewat /api/auth/google sebagai admin,
# lalu salin refresh token ke production.
#
# GOOGLE_CLIENT_CONFIG: isi file client_secret_*.json dari Google Cloud
#   Console sebagai satu baris JSON. Boleh format {"web": ...} atau
#   {"installed": ...}.
# GOOGLE_DRIVE_FOLDER_ID: ID folder Drive tujuan. Fallback ke FOLDER_ID.
# GOOGLE_REDIRECT_URI: URI callback yang terdaftar di Google Cloud Console.
#   Dev:        http://localhost:3000/api/auth/google/callback
#   Production: https://<domain>/api/auth/google/callback
# GOOGLE_REFRESH_TOKEN: WAJIB di production (filesystem Vercel tidak
#   persisten). Di lokal boleh dikosongkan — token disimpan di
#   .data/google-oauth-token.json.
#
# Batasan scope drive.file: hanya file yang dibuat/dibuka oleh aplikasi
# ini yang terlihat. Foto yang di-drop manual ke folder tidak muncul.
#
GOOGLE_CLIENT_CONFIG={"web":{"client_id":"...","client_secret":"...","redirect_uris":["http://localhost:3000/api/auth/google/callback"]}}
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_REFRESH_TOKEN=""
